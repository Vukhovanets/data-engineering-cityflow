@startuml
hide circle
skinparam linetype ortho

entity "core.customers" as customers {
  * customer_id : TEXT <<PK>>
  --
  * full_name : TEXT
  * city : TEXT
  * registered_at : TIMESTAMPTZ
}

entity "core.merchants" as merchants {
  * merchant_id : TEXT <<PK>>
  --
  * merchant_name : TEXT
  * city : TEXT
  * opened_at : TIMESTAMPTZ
}

entity "core.products" as products {
  * product_id : TEXT <<PK>>
  --
  * merchant_id : TEXT <<FK>>
  * product_name : TEXT
  * unit_price_uah : NUMERIC(12,2)
  * is_active : BOOLEAN
}

entity "core.orders" as orders {
  * order_id : TEXT <<PK>>
  --
  * customer_id : TEXT <<FK>>
  * merchant_id : TEXT <<FK>>
  * created_at : TIMESTAMPTZ
  * order_status : TEXT
  * currency : TEXT
  * subtotal_amount : NUMERIC(12,2)
  * delivery_fee : NUMERIC(12,2)
  * discount_amount : NUMERIC(12,2)
  * total_amount : NUMERIC(12,2)
}

entity "core.order_items" as order_items {
  * order_item_id : TEXT <<PK>>
  --
  * order_id : TEXT <<FK>>
  * product_id : TEXT <<FK>>
  * quantity : INTEGER
  * unit_price : NUMERIC(12,2)
  * line_discount : NUMERIC(12,2)
  * line_total : NUMERIC(12,2)
  * currency : TEXT
}

merchants ||--o{ products : "merchant_id"
customers ||--o{ orders : "customer_id"
merchants ||--o{ orders : "merchant_id"
orders ||--o{ order_items : "order_id"
products ||--o{ order_items : "product_id"
@enduml